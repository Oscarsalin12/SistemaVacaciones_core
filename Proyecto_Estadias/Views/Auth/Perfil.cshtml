@model Proyecto_Estadias.ViewModels.PerfilVM
@using Proyecto_Estadias.Helpers
@using Proyecto_Estadias.Models
@{
    ViewBag.Title = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var identity = (System.Security.Claims.ClaimsIdentity)User.Identity;

    // LÓGICA PARA VERIFICAR SI ES ADMIN
    bool esAdministrador = false;
    if (User.Identity.IsAuthenticated)
    {
        // Si es la cuenta maestra, le damos permiso de todo
        if (User.Identity.Name == "Admin")
        {
            esAdministrador = true;
        }
        else
        {
            // Si es un usuario normal, buscamos en la BD
            using (var db = new Proyecto_Estadias.Models.Vacaciones_ProyectoEntities())
            {
                var currentUser = db.Usuarios.FirstOrDefault(u => u.Usuario == User.Identity.Name);
                if (currentUser != null && currentUser.BitAdministrador == true)
                {
                    esAdministrador = true;
                }
            }
        }
    }
}

<div class="container profile-container">
    <div class="profile-header text-center">
        <h2 class="mb-2">Bienvenido, @Model.Usuario.Usuario</h2>
        <p class="profile-subtitle">Selecciona una empresa para ver sus SubEmpresas</p>
    </div>

    @* AQUÍ APLICAMOS LA RESTRICCIÓN DEL BOTÓN *@
    @if (esAdministrador)
    {
        <div class="text-center mb-4">
            <button type="button" class="btn btn-gradient" onclick="cargarFormulario('@Url.Action("InsertarEmpresa", "Empresas")', 'Nueva Empresa')">
                ➕ Agregar Empresa
            </button>
        </div>
    }

    <div class="row justify-content-center">
        @foreach (var empresa in Model.Empresas)
        {
            <div class="col-lg-4 col-md-6 mb-4 d-flex align-items-stretch">
                <div class="card card-company w-100">
                    <img src="@(empresa.Logo != null
                        ? $"data:image/png;base64,{Convert.ToBase64String(empresa.Logo)}"
                        : Url.Content("~/Content/imagenes/empresas/default.jpg"))"
                         alt="Logo de @empresa.Nombre"
                         style="max-height: 180px; object-fit: contain; padding: 10px;"
                         class="card-img-top" />

                    <div class="card-body text-center d-flex flex-column">
                        <h5 class="card-title">@empresa.Nombre</h5>
                        <p class="card-text mb-1"><strong>RFC:</strong> @empresa.Rfc</p>
                        <p class="card-text mb-3"><strong>Dirección:</strong> @empresa.Direccion</p>
                        <div class="mt-auto">
                            @Html.ActionLink("Ver Filiales", "SeleccionarSubempresa", "Auth",
                                new { id = empresa.Id },
                                new { @class = "btn btn-gradient" })
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="modal fade" id="modalGeneral" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTitulo">Formulario</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" id="modalCuerpo">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Función para cargar el modal
        async function cargarFormulario(url, titulo) {
            const modalElement = document.getElementById('modalGeneral');
            const modal = new bootstrap.Modal(modalElement);
            const cuerpo = document.getElementById('modalCuerpo');

            document.getElementById('modalTitulo').innerText = titulo;
            cuerpo.innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div></div>';

            modal.show();

            try {
                const respuesta = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' } // Asegura que ASP.NET detecte IsAjaxRequest
                });
                if (!respuesta.ok) throw new Error("Error al cargar");
                cuerpo.innerHTML = await respuesta.text();
            } catch (error) {
                cuerpo.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
            }
        }

        // Manejador de formularios dinámicos
        document.addEventListener('submit', async (e) => {
            if (e.target.id === 'formGenerico') {
                e.preventDefault();
                const btn = e.target.querySelector('button[type="submit"]');
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando...';

                try {
                    const formData = new FormData(e.target);
                    const res = await fetch(e.target.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (res.ok) {
                        // Si el controlador devuelve 200 OK
                        location.reload();
                    } else {
                        // Si hay error de validación (400), volvemos a inyectar la parcial con errores
                        const htmlError = await res.text();
                        document.getElementById('modalCuerpo').innerHTML = htmlError;
                    }
                } catch (error) {
                    toastr.error('Error de conexión con el servidor');
                    btn.disabled = false;
                    btn.innerHTML = 'Guardar';
                }
            }
        });

        // Notificaciones Toastr (Al cargar la página)
        $(document).ready(function() {
            @if (TempData["EmpresaCreada"] != null) {
                @:toastr.success('Empresa creada exitosamente', 'Éxito');
            }
            @if (TempData["ExitoSub"] != null) {
                @:toastr.success('Subempresa creada correctamente', 'Éxito');
            }
        });
    </script>
}

<style>
    .profile-header {
        font-size: 28px;
        font-weight: 700;
        text-align: center;
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        padding: 20px 15px;
        border-radius: 15px 15px 10px 10px;
        margin-bottom: 30px;
    }

    body {
        background: #f8f9fa;
        font-family: 'Segoe UI', sans-serif;
    }

    .profile-container {
        max-width: 960px;
        margin: 40px auto 80px auto;
        padding: 30px;
        background-color: white;
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    }

    .profile-header h2 {
        font-size: 2rem;
        font-weight: 700;
        color: white;
    }

    .profile-subtitle {
        color: whitesmoke;
        margin-bottom: 20px;
        font-size: 1rem;
    }

    .card-company {
        border: none;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
    }

        .card-company:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        }

        .card-company img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .card-company .card-title {
            color: #222;
            font-weight: 600;
            margin-bottom: 10px;
        }

    .btn-gradient {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: #fff !important;
        border: none;
        border-radius: 50px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #4b0082, #0000ff);
            box-shadow: 0 4px 10px rgba(75, 0, 130, 0.5);
            color: #fff !important;
        }
</style>