@{
    ViewBag.Title = "Cambiar Contraseña";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />

<style>
    body {
        background: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .register-container {
        background-color: white;
        padding: 30px;
        margin: 80px auto;
        border-radius: 15px;
        max-width: 600px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .register-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        text-align: center;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 24px;
        font-weight: bold;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border-color: #6F42C1;
    }

        .btn-primary:hover {
            background-color: #5a379e;
            border-color: #5a379e;
        }

    .alert-danger {
        margin-top: 15px;
    }
</style>

<div class="register-container">
    <div class="register-header">
        Cambiar Contraseña
    </div>

    @if (TempData["ContrasenaCambiada"] != null && (bool)TempData["ContrasenaCambiada"])
    {
        <div class="alert alert-success mt-3">
            Contraseña cambiada con éxito. Por favor, vuelva a iniciar sesión.
        </div>
    }

    @using (Html.BeginForm("CambiarContrasena", "Auth", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group mt-3">
            @Html.Label("Contraseña Actual")
            @Html.Password("viejaContrasenia", null, new { @class = "form-control", placeholder = "Contraseña actual", required = "required" })
        </div>

        <div class="form-group">
            @Html.Label("Nueva Contraseña")
            @Html.Password("nuevaContrasenia", null, new { @class = "form-control", placeholder = "Nueva contraseña", required = "required" })
        </div>

        <div class="form-group text-center mt-3">
            <input type="submit" value="Actualizar Contraseña" class="btn btn-primary" />
        </div>
    }
</div>
