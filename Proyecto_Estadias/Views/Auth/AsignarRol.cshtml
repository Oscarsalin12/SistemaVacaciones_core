@model Proyecto_Estadias.ViewModels.AsignarRolVM

@{
    ViewBag.Title = "AsignarRol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .asignarrol-container {
        background-color: white;
        padding: 30px;
        margin: 80px auto 80px auto;
        border-radius: 15px;
        max-width: 600px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .asignarrol-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        text-align: center;
        padding: 15px;
        border-radius: 15px 15px 0 0;
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .form-group label {
        font-weight: 600;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border-color: #6F42C1;
        border-radius: 8px;
        padding: 10px 0;
        font-weight: 600;
        width: 100%;
        transition: background 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #5a379e;
            border-color: #5a379e;
        }
</style>

<div class="asignarrol-container">
    <h2 class="asignarrol-header">Asignar Rol a Usuario</h2>

    @using (Html.BeginForm("AsignarRol", "Auth", FormMethod.Post))
    {
        @Html.HiddenFor(Model => Model.IdUsuario)

        <div class="form-group">
            @Html.LabelFor(model => model.IdRol, "Rol")
            @Html.DropDownListFor(model => model.IdRol, new SelectList(Model.ListaRoles, "Value", "Text"), "Seleccione un rol", new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.IdEmpresa, "Empresa")
            @Html.DropDownListFor(model => model.IdEmpresa, new SelectList(Model.ListaEmpresas, "Value", "Text"), "Seleccione una empresa", new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-primary">Asignar Rol</button>
    }
</div>
