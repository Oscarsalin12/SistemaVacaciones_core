@model Proyecto_Estadias.ViewModels.UsuariosVM

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 <link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    body {
        background: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .login-container {
        background-color: white;
        padding: 30px;
        margin: 80px auto;
        border-radius: 15px;
        max-width: 500px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .login-header {
        background: linear-gradient(to right, #0000ff , #4b0082);
        color: white;
        text-align: center;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 24px;
        font-weight: bold;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border-color: #6F42C1;
    }

        .btn-primary:hover {
            background-color: #5a379e;
            border-color: #5a379e;
        }

    .alert-danger {
        margin-top: 15px;
    }
</style>

<div class="login-container">
    <div class="login-header">
        Iniciar Sesión
    </div>

    @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal mt-3">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.LabelFor(model => model.Usuario)
                @Html.EditorFor(model => model.Usuario, new { htmlAttributes = new { @class = "form-control", placeholder = "Usuario" } })
                @Html.ValidationMessageFor(model => model.Usuario, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Contrasenia)
                @Html.PasswordFor(model => model.Contrasenia, new { @class = "form-control", placeholder = "Contraseña" })
                @Html.ValidationMessageFor(model => model.Contrasenia, "", new { @class = "text-danger" })
            </div>

            <div class="form-group text-center">
                <button type="submit" class="btn btn-primary">Iniciar sesión</button>
            </div>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }
</div>

@section Scripts {
    <script>

          $(function () {
            @if (TempData["UsuarioCreado"] != null)
            {
                @:toastr.success('Usuario Creado exitosamente', 'Éxito');
            }
        }); 


    </script>
    
    }
