@model Proyecto_Estadias.Models.Empleados

@{
    ViewBag.Title = "Panel del Empleado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    body {
        background: #f5f7fa;
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    .panel-container {
        max-width: 700px;
        margin: 80px auto;
        padding: 30px;
        background-color: white;
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .panel-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        text-align: center;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 30px;
        font-size: 24px;
        font-weight: bold;
    }

    .panel-info p {
        font-size: 16px;
        margin-bottom: 10px;
        color: #333;
    }

    .btn-group {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .btn-primary-custom,
    .btn-logout {
        display: inline-block;
        padding: 12px 24px;
        font-size: 16px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        min-width: 180px;
        text-align: center;
    }

    .btn-primary-custom {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
    }

        .btn-primary-custom:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }

    .btn-logout {
        background: linear-gradient(to right, #ff416c, #ff4b2b);
        color: white;
        margin-top: 0;
    }

        .btn-logout:hover {
            opacity: 0.9;
            transform: translateY(-2px);
        }
</style>

<div class="panel-container">
    <div class="panel-header">
        Bienvenido, @Model.Nombre
    </div>

    <div class="panel-info">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Número de empleado:</strong> @Model.NumEmpleado</p>
                <p><strong>Fecha de ingreso:</strong> @Model.FechaIDeIngreso.ToShortDateString()</p>
                <p><strong>Días de vacaciones disponibles:</strong> @Model.DiasDisponibles</p>
            </div>
            <div class="col-md-6">
                <p><strong>Departamento:</strong> @Model.Departamentos.NombreDep</p>
                <p><strong>Empresa/Subempresa:</strong> @Model.SubEmpresas.Nombre</p>
                <p><strong>Horas disponibles:</strong> @Model.HorasRestantesDelDia</p>
            </div>
        </div>
    </div>

    <div class="btn-group">
        @* Botón para ir a la vista de crear solicitud de permiso *@
        <a href="@Url.Action("SolicitarPermiso", "Permisos", new { idEmpleado = Model.Id })"
           class="btn-primary-custom">Solicitar Permiso</a>

        <a href="@Url.Action("PermisosEmpleados", "Permisos", new { idEmpleado = Model.Id })"
           class="btn-primary-custom">Permisos Solicitados</a>

        @* Botón de cerrar sesión *@
        <a href="@Url.Action("LogoutEmpleado", "Empleados")" class="btn-logout">Cerrar Sesión</a>
    </div>
</div>
