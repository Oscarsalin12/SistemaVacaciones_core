@model PagedList.IPagedList<Proyecto_Estadias.ViewModels.EmpleadosVM>
@using PagedList.Mvc
@using PagedList
@{
    ViewBag.Title = "Empleados por Subempresa";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var idSub = ViewBag.IdSub ?? 0;
    var subempresaNombre = ViewBag.SubempresaNombre ?? "Subempresa";
    var departamentos = ViewBag.Departamentos as SelectList;
    var selectedDept = Request.QueryString["bus"];
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    .content-box {
        background-color: white;
        padding: 30px;
        margin: 40px auto;
        border-radius: 15px;
        max-width: 1400px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        overflow-x: auto;
    }

    .content-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 22px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
    }

        .btn-primary:hover {
            background-color: #5a379e;
        }

    .btn-success {
        border-radius: 8px;
    }

    .btn-gradient {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 500;
        transition: background 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #5a379e, #0000ff);
            color: white;
        }

    table.table {
        border: 1px solid #dee2e6;
    }

    table th, table td {
        text-align: center;
        vertical-align: middle;
    }

    table thead {
        background-color: #343a40;
        color: white;
        margin-top: 15px;
        border: none;
    }

    .pagination {
        margin-top: 30px;
    }

        .pagination li {
            display: inline-block;
            margin: 0 3px;
        }

        .pagination a,
        .pagination span {
            padding: 6px 12px;
            border: 1px solid #ddd;
            color: #007bff;
            text-decoration: none;
            border-radius: 5px;
        }

        .pagination .active span {
            background-color: #007bff;
            color: white;
            border-color: #007bff;
        }

    .table-responsive {
        overflow-x: auto;
        width: 100%;
    }
</style>

@Html.ActionLink("Ver Filiales", "SeleccionarSubempresa", "Auth", new { id = ViewBag.IdEmpresaMadre }, new { @class = "btn btn-gradient" })
@Html.ActionLink("Ver Bajas", "ListaEmpleadosDadosDeBaja", "Empleados", new { idSub = idSub }, new { @class = "btn btn-gradient" })

<div class="content-box">
    <div class="content-header">
        Empleados de @subempresaNombre
    </div>

    @using (Html.BeginForm("ListaEmpleadosSubempresa", "Empleados", FormMethod.Get))
    {
        <input type="hidden" name="idSub" value="@idSub" />

        <div class="form-group row">
            <label class="col-sm-4 col-form-label">Filtrar por departamento:</label>
            <div class="col-sm-5">
                @Html.DropDownList("bus", new SelectList(departamentos, "Value", "Text", selectedDept),
                    "Todos", new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group row mt-3">
            <label class="col-sm-4 col-form-label">Búsqueda por nombre:</label>
            <div class="col-sm-5">
                @Html.TextBox("busqueda", null, new { @class = "form-control", placeholder = "Nombre del empleado" })
            </div>
        </div>

        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
            <a href="@Url.Action("ListaEmpleadosSubempresa", "Empleados", new { idSub = idSub })" class="btn btn-secondary btn-sm">Limpiar</a>
        </div>
    }

    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">No hay empleados para mostrar.</div>
        <div class="text-center mt-3">
            <button class="btn btn-success" onclick="abrirModalFormulario(0, @idSub)">Añadir empleados</button>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped w-100">
                <thead>
                    <tr>
                        <th>Num. Empleado</th>
                        <th>Nombre</th>
                        <th>Fecha de Ingreso</th>
                        <th>Horas disponibles</th>
                        <th>Días Disponibles</th>
                        <th>Departamento</th>
                        <th>Permisos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td>@emp.NumEmpleado</td>
                            <td>@emp.Nombre</td>
                            <td>@emp.FechaDeIngreso.ToShortDateString()</td>
                            <td>@emp.HorasRestantesDelDia</td>
                            <td>@emp.DiasDisponibles</td>
                            <td>@emp.NombreDepartamento</td>
                            <td>
                                <button class="btn btn-sm btn-gradient" onclick="abrirModalPermiso(@emp.Id)">Crear Permiso</button>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-info text-white" onclick="abrirModalDetalles(@emp.Id)">Ver Detalles</button>
                                <button class="btn btn-sm btn-gradient" onclick="abrirModalFormulario(@emp.Id, @idSub)">Editar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-center mt-4">
            @Html.ActionLink("Reportes", "PaginacionPorEmpresa", "Permisos", new { idEmpresa = Model.First().IdEmpresa }, new { @class = "btn btn-gradient" })
            @Html.ActionLink("Solicitudes pendientes", "PermisosPendientes", "Permisos", new { idEmpresa = Model.First().IdEmpresa }, new { @class = "btn btn-gradient ml-2" })
            <button class="btn btn-success ml-2" onclick="abrirModalFormulario(0, @idSub)">Añadir empleados</button>
        </div>

        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager(
                Model,
                page => Url.Action("ListaEmpleadosSubempresa", new
                {
                    idSub = idSub,
                    bus = Request["bus"],
                    busqueda = Request["busqueda"],
                    page = page
                }),
                new PagedListRenderOptions
                {
                    Display = PagedListDisplayMode.IfNeeded,
                    MaximumPageNumbersToDisplay = 5,
                    LinkToPreviousPageFormat = "«",
                    LinkToNextPageFormat = "»",
                    UlElementClasses = new[] { "pagination" },
                    LiElementClasses = new[] { "page-item" },
                }
            )
        </div>
    }
</div>

<div class="modal fade" id="modalEmpleado" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header content-header m-0 mb-3" style="border-radius: 0;">
                <h5 class="modal-title text-white" id="modalEmpleadoTitle"></h5>
            </div>
            <div class="modal-body" id="modalEmpleadoBody">
            </div>
            <div class="modal-footer" id="modalEmpleadoFooter">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="$('#modalEmpleado').modal('hide')">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnGuardarEmpleado">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEmp = $('#modalEmpleado');

        $(function () {
            @if (TempData["PermisoCreado"] != null)
            {
                @:toastr.success('Permiso creado exitosamente', 'Éxito');
            }
        });

        // ==========================================
        //         MODALES DE EMPLEADOS
        // ==========================================

        async function abrirModalFormulario(idEmpleado, idSubempresa) {
            const isNew = idEmpleado === 0;
            const title = isNew ? "Registrar Nuevo Empleado" : "Editar Empleado";

            const url = isNew
                ? `@Url.Action("InsertarEmpleado", "Empleados")?idsub=${idSubempresa}`
                : `@Url.Action("EditarEmpleado", "Empleados")?id=${idEmpleado}`;

            document.getElementById('modalEmpleadoTitle').innerText = title;
            document.getElementById('btnGuardarEmpleado').style.display = 'inline-block';
            document.getElementById('btnGuardarEmpleado').setAttribute('onclick', 'guardarEmpleado()');

            const response = await fetch(url);
            const html = await response.text();
            document.getElementById('modalEmpleadoBody').innerHTML = html;

            modalEmp.modal('show');
        }

        async function abrirModalDetalles(idEmpleado) {
            document.getElementById('modalEmpleadoTitle').innerText = "Detalles del Empleado";
            document.getElementById('btnGuardarEmpleado').style.display = 'none';

            const url = `@Url.Action("DetallesEmpleado", "Empleados")?id=${idEmpleado}`;
            const response = await fetch(url);
            const html = await response.text();

            document.getElementById('modalEmpleadoBody').innerHTML = html;
            modalEmp.modal('show');
        }

        async function guardarEmpleado() {
            const form = document.getElementById('frmEmpleado');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            const idEmpleado = formData.get("Id");
            const isNew = idEmpleado == "0" || idEmpleado === "";

            const urlPost = isNew
                ? '@Url.Action("InsertarEmpleado", "Empleados")'
                : '@Url.Action("EditarEmpleado", "Empleados")';

            try {
                const response = await fetch(urlPost, { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    modalEmp.modal('hide');
                    toastr.success(result.message, 'Éxito');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    toastr.error(result.message, 'Error');
                }
            } catch (error) {
                toastr.error('Error de comunicación con el servidor', 'Error');
            }
        }

        // ==========================================
        //         MODALES DE PERMISOS
        // ==========================================

        async function abrirModalPermiso(idEmpleado) {
            document.getElementById('modalEmpleadoTitle').innerText = "Registrar Permiso";
            document.getElementById('btnGuardarEmpleado').style.display = 'inline-block';
            document.getElementById('btnGuardarEmpleado').setAttribute('onclick', 'guardarPermiso()');

            const url = `@Url.Action("CrearPermiso", "Permisos")?idEmpleado=${idEmpleado}`;
            const response = await fetch(url);
            const html = await response.text();

            document.getElementById('modalEmpleadoBody').innerHTML = html;

            // Forzamos la fecha de hoy si el controlador no las trajo llenas
            const hoy = new Date().toISOString().split('T')[0];
            if(!document.getElementById('FechaInicio').value) document.getElementById('FechaInicio').value = hoy;
            if(!document.getElementById('FechaFinal').value) document.getElementById('FechaFinal').value = hoy;

            modalEmp.modal('show');
        }

        // Detecta por los bits (data-horas) qué campos mostrar
        function toggleCamposPermiso() {
            const select = document.getElementById('IdTipoPermiso');
            const selectedOption = select.options[select.selectedIndex];

            // Leemos el atributo data-horas que insertamos en la vista parcial
            const descuentaHoras = selectedOption.getAttribute('data-horas') === 'true';

            if (descuentaHoras) {
                $('#horasField').slideDown();
                $('#fechasGroup').hide();

                // Quitamos requirimientos de fechas para no bloquear el HTML5 Validator
                document.getElementById('FechaInicio').removeAttribute('required');
                document.getElementById('FechaFinal').removeAttribute('required');
                document.getElementById('CantidadHorasSolicitadas').setAttribute('required', 'required');
            } else {
                $('#horasField').slideUp();
                document.getElementById('CantidadHorasSolicitadas').value = '';
                document.getElementById('CantidadHorasSolicitadas').removeAttribute('required');

                $('#fechasGroup').slideDown();
                document.getElementById('FechaInicio').setAttribute('required', 'required');
                document.getElementById('FechaFinal').setAttribute('required', 'required');
            }
        }

        async function guardarPermiso() {
            const form = document.getElementById('frmPermiso');

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const formData = new FormData(form);
            const urlPost = '@Url.Action("CrearPermiso", "Permisos")';

            try {
                const response = await fetch(urlPost, { method: 'POST', body: formData });
                const result = await response.json();

                if (result.success) {
                    modalEmp.modal('hide');
                    toastr.success(result.message, 'Éxito');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    toastr.error(result.message, 'Error');
                }
            } catch (error) {
                toastr.error('Error de comunicación con el servidor', 'Error');
            }
        }
    </script>
}