@model Proyecto_Estadias.ViewModels.PermisosVM

@{
    ViewBag.Title = "Registrar Permiso";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    body {
        background: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .permiso-container {
        background-color: white;
        padding: 30px;
        margin: 80px auto;
        border-radius: 15px;
        max-width: 700px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    .permiso-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        text-align: center;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 24px;
        font-weight: bold;
    }

    .form-control {
        border-radius: 8px;
    }

    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border-color: #6F42C1;
    }

        .btn-primary:hover {
            background-color: #5a379e;
            border-color: #5a379e;
        }

    .form-group {
        margin-bottom: 20px;
    }

    #datosEmpleado p {
        margin: 0;
        font-size: 16px;
    }

    #horasField,
    #fechasGroup {
        display: none;
    }
</style>

<div class="permiso-container">
    <div class="permiso-header">
        Registrar Permiso
    </div>

    @using (Html.BeginForm("CrearPermiso", "Permisos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group mt-3">
            <p class="form-control-plaintext"><strong>@Model.NombreEmpleado</strong></p>
            @Html.HiddenFor(m => m.IdEmpleado)
            @Html.ValidationMessageFor(m => m.IdEmpleado, "", new { @class = "text-danger" })
        </div>

        <div id="datosEmpleado" class="mb-3">
            @Html.HiddenFor(m => m.IdEmpresa)
            <p><strong>Empresa:</strong> <span id="empresa">@Model.EmpresaNombre</span></p>
            <p><strong>Días de Vacaciones:</strong> <span id="vacaciones">@Model.VacacionesDisponibles</span></p>
            <p><strong>Horas Disponibles:</strong> <span id="horasDisponibles">@Model.HorasDisponibles</span></p>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdTipoPermiso)
            <select id="IdTipoPermiso" name="IdTipoPermiso" class="form-control">
                <option value="">Seleccione el motivo</option>
                @foreach (var motivo in Model.MotivosAusencia)
                {
                    <option value="@motivo.Id">@motivo.NombreMotivo</option>
                }
            </select>
            @Html.ValidationMessageFor(m => m.IdTipoPermiso, "", new { @class = "text-danger" })
        </div>

        <div id="fechasGroup">
            <div class="form-group">
                @Html.LabelFor(m => m.FechaInicio, "Fecha de inicio")
                @Html.TextBoxFor(m => m.FechaInicio, new { @type = "date", @class = "form-control", @Value = hoy })
                @Html.ValidationMessageFor(m => m.FechaInicio, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.FechaFinal, "Fecha final")
                @Html.TextBoxFor(m => m.FechaFinal, new { @type = "date", @class = "form-control", @Value = hoy })
                @Html.ValidationMessageFor(m => m.FechaFinal, "", new { @class = "text-danger" })
            </div>
        </div>

        <!-- Campo visible solo para vacaciones por tiempo -->
        <div class="form-group" id="horasField">
            <label for="CantidadHorasSolicitadas">Cantidad de horas solicitadas</label>
            <input type="number" class="form-control" id="CantidadHorasSolicitadas" name="CantidadHorasSolicitadas" min="1" />
        </div>

        <div class="form-group text-center">
            <button type="submit" class="btn btn-primary">Guardar Permiso</button>
            @Html.ActionLink("Ver empleados", "ListaEmpleadosSubempresa", "Auth",
                new { idSub = ViewBag.EmpresaId },
                new { @class = "btn btn-primary" })
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            const idVacacionesPorHoras = 3; // Ajusta al ID correcto del motivo 'Vacaciones por tiempo'

            $('#IdTipoPermiso').on('change', function () {
                const selected = parseInt($(this).val());

                if (selected === idVacacionesPorHoras) {
                    $('#horasField').slideDown();
                    $('#fechasGroup').hide();
                    const hoy = new Date().toISOString().split('T')[0];
                    $('#FechaInicio').val(hoy);
                    $('#FechaFinal').val(hoy);
                } else {
                    $('#horasField').slideUp();
                    $('#CantidadHorasSolicitadas').val('');
                    $('#fechasGroup').slideDown();
                }
            });

            $('#busquedaEmpleado').autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("BuscarEmpleado", "Permisos")',
                        data: { filtro: request.term },
                        success: function (data) {
                            if (data) {
                                response([{
                                    label: data.nombre + " (" + data.numEmpleado + ")",
                                    value: data.nombre,
                                    id: data.id,
                                    empresa: data.empresa,
                                    vacaciones: data.vacaciones,
                                    horas: data.horas,
                                    empresaId: data.empresaId
                                }]);
                            } else {
                                response([]);
                            }
                        }
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    $('#IdEmpleado').val(ui.item.id);
                    $('#empresa').text(ui.item.empresa);
                    $('#vacaciones').text(ui.item.vacaciones);
                    $('#horasDisponibles').text(ui.item.horas);
                    $('#IdEmpresa').val(ui.item.empresaId);
                }
            });
        });
    </script>
}
