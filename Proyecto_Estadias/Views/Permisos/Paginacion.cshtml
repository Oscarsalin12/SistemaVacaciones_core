@model PagedList.IPagedList<Proyecto_Estadias.ViewModels.PermisosPdfVM>
@using PagedList.Mvc

@{
    ViewBag.Title = "Listado de Permisos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var empresaId = ViewBag.EmpresaId;
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    .page-container {
        max-width: 1200px;
        margin: 40px auto;
    }

    .card-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        font-size: 20px;
        font-weight: bold;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        padding: 15px;
    }

    .btn-sm {
        border-radius: 8px;
    }
    .btn-reject {
        background: #dc3545;
        color: white;
        border: none;
    }
    .btn-primary {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
    }

    .btn-success {
        background: #28a745;
        border: none;
    }

    .btn-dark {
        margin-top: 15px;
        background: #343a40;
        border: none;
    }

    .pagination-container {
        text-align: center;
        margin-top: 20px;
    }

    .pagination > li > a, .pagination > li > span {
        border-radius: 6px !important;
        margin: 0 3px;
    }

    table th, table td {
        vertical-align: middle !important;
    }
</style>

@Html.ActionLink(
    "Ver empleados",
    "ListaEmpleadosSubempresa",
    "Empleados",
    new { idSub = ViewBag.EmpresaId },
    new { @class = "btn btn-primary" }
)

<div class="page-container">
    <div class="card shadow">
        <div class="card-header">
            Listado de permisos para super administrador
        </div>
        <div class="card-body">

            <!-- Filtros -->
            @using (Html.BeginForm("PaginacionPorEmpresa", "Permisos", FormMethod.Get))
            {
                <input type="hidden" name="idEmpresa" value="@ViewBag.EmpresaId" />

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label>Departamento</label>
                   +
                        @Html.DropDownList("departamento", ViewBag.Departamentos as SelectList, "Todos", new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Motivo</label>
                        @Html.DropDownList("motivo", ViewBag.Motivos as SelectList, "Todos", new { @class = "form-control" })
                    </div>
                    <div class="col-md-4">
                        <label>Nombre del empleado</label>
                        @Html.TextBox("nombre", Request["nombre"] ?? "", new { @class = "form-control", placeholder = "Buscar por nombre" })
                    </div>
                </div>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-sm">Filtrar</button>
                    <a href="@Url.Action("PaginacionPorEmpresa", "Permisos", new { idEmpresa = ViewBag.EmpresaId })" class="btn btn-secondary btn-sm">Limpiar</a>
                </div>
            }

            <hr />

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">
                    <thead class="table-dark text-center">
                        <tr>
                            <th>N.Emp</th>
                            <th>Empleado</th>
                            <th>Empresa</th>
                            <th>Motivo</th>
                            <th>Generado</th>
                            <th>Inicio</th>
                            <th>Final</th>
                            <th>Generales</th>
                            <th>Individual</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tablaPermisos">
                        @foreach (var p in Model)
                        {
                            <tr class="text-center">
                                <td>@p.Empleados.NumEmpleado</td>
                                <td>@p.Empleados.Nombre</td>
                                <td>@p.SubEmpresas.Nombre</td>
                                <td>@p.MotivosAusencia.NombreMotivo</td>
                                <td>@p.FechaGeneracion.ToString("dd/MM/yyyy")</td>
                                <td>@p.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>@p.FechaFinal.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @Html.ActionLink("Historial", "GenerarPDFEmpleado", "Permisos", new { id = p.IdEmpleado }, new { @class = "btn btn-primary btn-sm" })
                                </td>
                                <td>
                                    <a href="@Url.Action("GenerarPDFPermiso", "Permisos", new { idPermiso = p.Id })" class="btn btn-success btn-sm" target="_blank">
                                        Generar Permiso
                                    </a>
                                <td>
                                    @using (Html.BeginForm("CambiarEstadopag", "Permisos", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()

                                        @Html.Hidden("id", p.Id)
                                        <input type="hidden" name="idEmpresa" value="@empresaId" />
                                        <button type="submit" name="estado" value="Rechazado" class="btn btn-sm btn-reject">Descartar</button>
                                    }
                                </td> 
                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-center">
                @Html.ActionLink("📥 Generar Reporte General", "GenerarPDF", "Permisos", new
          {
              idEmpresa = ViewBag.EmpresaId,
              nombre = Request["nombre"],
              departamento = Request["departamento"],
              motivo = Request["motivo"]
          }, new { @class = "btn btn-dark btn-sm", target = "_blank" })

            </div>

            <div class="pagination-container">
                @Html.PagedListPager(Model, page => Url.Action("PaginacionPorEmpresa", new
                {
                    page,
                    idEmpresa = ViewBag.EmpresaId,
                    nombre = Request["nombre"],
                    departamento = Request["departamento"],
                    motivo = Request["motivo"]
                }), new PagedListRenderOptions
                {
                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                    DisplayEllipsesWhenNotShowingAllPageNumbers = true,
                    MaximumPageNumbersToDisplay = 5,
                    ContainerDivClasses = new[] { "pagination-container" },
                    UlElementClasses = new[] { "pagination justify-content-center" },
                    LiElementClasses = new[] { "page-item" }
                })
            </div>
        </div>
    </div>
</div>
