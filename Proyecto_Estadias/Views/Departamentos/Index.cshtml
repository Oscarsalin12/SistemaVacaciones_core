@model List<Proyecto_Estadias.ViewModels.DepartamentosVM>

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    /* Estilos del contenedor principal */
    .content-box {
        background-color: white;
        padding: 30px;
        margin: 40px auto;
        border-radius: 15px;
        max-width: 1400px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        overflow-x: auto;
    }

    /* Estilo del encabezado con el degradado */
    .content-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 22px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
    }

    /* Estilos de botones */
    .btn-gradient {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 6px 12px;
        font-weight: 500;
        transition: background 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #5a379e, #0000ff);
            color: white;
        }

    .btn-success, .btn-danger, .btn-secondary {
        border-radius: 8px;
    }

    /* Estilos de tabla unificados */
    table.table {
        border: 1px solid #dee2e6;
    }

    table th, table td {
        text-align: center;
        vertical-align: middle;
    }

    table thead {
        background-color: #343a40 !important;
        color: white;
        margin-top: 15px;
        border: none;
    }

    .table-responsive {
        overflow-x: auto;
        width: 100%;
    }
</style>

<div class="content-box">
    <div class="content-header">
        Gestión de Departamentos
    </div>

    <div class="text-end mb-3">
        <button class="btn btn-success" onclick="abrirModal(0)">Nuevo Departamento</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped w-100" id="tablaDepartamentos">
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Nombre</th>
                    <th>Encargado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id="fila-@item.Id">
                        <td>@item.ClaveDep</td>
                        <td class="text-start">@item.NombreDep</td>
                        <td class="text-start">@item.NombreEmcargado</td>
                        <td>
                            <button class="btn btn-gradient btn-sm" onclick="abrirModal(@item.Id)">Editar</button>
                            <button class="btn btn-danger btn-sm" onclick="eliminarDep(@item.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalDepartamento" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header content-header m-0 mb-3" style="border-radius: 0;">
                <h5 class="modal-title text-white" id="modalTitle">Departamento</h5>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="$('#modalDepartamento').modal('hide')">Cerrar</button>
                <button type="button" class="btn btn-gradient" onclick="guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
    const modalElement = $('#modalDepartamento');

    async function abrirModal(id) {
        const title = id === 0 ? "Nuevo Departamento" : "Editar Departamento";
        const url = id === 0 ? '@Url.Action("Create", "Departamentos")' : `@Url.Action("Edit", "Departamentos")/${id}`;

        document.getElementById('modalTitle').innerText = title;

        try {
            const response = await fetch(url);
            const html = await response.text();
            document.getElementById('modalBody').innerHTML = html;

            modalElement.modal('show');
        } catch (error) {
             alert('Error al cargar el formulario.');
        }
    }

    async function guardar() {
        const form = document.getElementById('formDepartamento');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const formData = new FormData(form);
        const id = formData.get("Id");

        const url = id == "0" || id == "" ? '@Url.Action("Create", "Departamentos")' : '@Url.Action("Edit", "Departamentos")';

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const resultado = await response.json();
            if (resultado.success) {
                // Recargamos la página para que la tabla se actualice fácilmente
                location.reload();
            } else {
                alert(resultado.message);
            }
        } catch (error) {
            alert('Error de comunicación con el servidor');
        }
    }

    async function eliminarDep(id) {
        if (!confirm("¿Estás seguro de que deseas eliminar este departamento?")) return;

        try {
            const response = await fetch(`@Url.Action("Delete", "Departamentos")/${id}`, { method: 'POST' });
            const res = await response.json();

            if (res.success) {
                // Manipulación del DOM: Borramos la fila sin recargar la página
                document.getElementById(`fila-${id}`).remove();
            } else {
                alert("No se pudo eliminar el departamento. Verifica que no tenga dependencias.");
            }
        } catch (error) {
             alert('Error de comunicación con el servidor');
        }
    }
    </script>
}