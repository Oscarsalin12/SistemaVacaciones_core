@model SistemaVacaciones.Core.ViewModels.PermisosVM

<form id="frmPermiso">
    @Html.HiddenFor(m => m.IdEmpleado)

    @Html.HiddenFor(m => m.IdEmpresa)

    <div class="alert alert-info p-3 mb-3" style="border-radius: 8px;">
        <h6 class="mb-2 text-primary"><strong>@Model.NombreEmpleado</strong></h6>
        <div class="row text-dark" style="font-size: 14px;">
            <div class="col-6"><strong>Empresa:</strong> @Model.EmpresaNombre</div>
            <div class="col-6"><strong>Vacaciones:</strong> @Model.VacacionesDisponibles días</div>
            <div class="col-6 mt-1"><strong>Horas Disp:</strong> @Model.HorasDisponibles hrs</div>
        </div>
    </div>

    <div class="form-group mb-2">
        <label class="font-weight-bold">Motivo del Permiso</label>
        <select id="IdTipoPermiso" name="IdTipoPermiso" class="form-control" required onchange="toggleCamposPermiso()">
            <option value="" data-horas="false">Seleccione el motivo</option>
            @foreach (var motivo in Model.MotivosAusencia)
            {
                <option value="@motivo.Id" data-horas="@(motivo.BitDescuentoHoras == true ? "true" : "false")">
                    @motivo.NombreMotivo
                </option>
            }
        </select>
    </div>

    <div id="fechasGroup">
        <div class="row">
            <div class="col-md-6 form-group mb-2">
                <label>Fecha de inicio</label>
                @Html.TextBoxFor(m => m.FechaInicio, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", required = "required" })
            </div>
            <div class="col-md-6 form-group mb-2">
                <label>Fecha final</label>
                @Html.TextBoxFor(m => m.FechaFinal, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", required = "required" })
            </div>
        </div>
    </div>

    <div class="form-group mb-2" id="horasField" style="display: none;">
        <label>Cantidad de horas solicitadas</label>
        <input type="number" class="form-control" id="CantidadHorasSolicitadas" name="CantidadHorasSolicitadas" min="1" />
    </div>
</form>