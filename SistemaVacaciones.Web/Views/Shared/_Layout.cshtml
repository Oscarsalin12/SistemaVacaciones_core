@inject SistemaVacaciones.Core.Interfaces.IAuthServices AuthServices
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Vacaciones Filiares</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/custom-navbar.css" rel="stylesheet" />
    <link href="~/css/site-theme.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">

    @* Librerías Externas *@
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://kit.fontawesome.com/5549e90f49.js" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.8/umd/popper.min.js"></script>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        bool esAdministrador = false;
        if (User.Identity?.IsAuthenticated == true)
        {
            if (User.Identity.Name == "Admin" || User.IsInRole("Admin") || User.IsInRole("Administrador") || User.IsInRole("AdministradorGeneral"))
            {
                esAdministrador = true;
            }
            else
            {
                esAdministrador = AuthServices.EsAdmin(User.Identity.Name ?? "");
            }
        }
    }

    @* Configuración de Notificaciones *@
    <script>
        $(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "timeOut": "4000"
            };

            @if (TempData["LoginExitoso"] != null) {
                @:toastr.success('Sesión iniciada correctamente', 'Éxito');
            }
            @if (TempData["mensaje"] != null) {
                @:toastr.info('@TempData["mensaje"]');
            }
        });
    </script>

    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Perfil", "Auth")">
                <img src="~/Imagenes/1.jpg" alt="Logo" height="40" class="me-2" />
                Grupo Juárez y Asociados
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    @* AQUÍ APLICAMOS LA VALIDACIÓN: SOLO SE MUESTRA SI ES ADMIN *@
                    @if (esAdministrador)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navGestion" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-users-cog"></i> Gestión de Configuración
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navGestion">
                                <li>@Html.ActionLink("Gestión de Accesos", "Index", "Usuarios", null, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="dropdown-header">Configuración de Catálogos</li>
                                <li>@Html.ActionLink("Departamentos", "Index", "Departamentos", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Motivos de Ausencia", "Index", "Motivos", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto">
                    @* El menú de la derecha se sigue mostrando para cualquier usuario logueado *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle"></i> @User.Identity.Name
                                @if (esAdministrador)
                                {
                                    <span class="badge bg-danger ms-1" style="font-size: 0.7em;">Admin</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li>@Html.ActionLink("Mi Perfil", "Perfil", "Auth", null, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider"></li>
                                <li>@Html.ActionLink("Cerrar Sesión", "LogOut", "Auth", null, new { @class = "dropdown-item text-danger" })</li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="guestDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-sign-in-alt"></i> Accesos
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="@Url.Action("Login", "Auth")">Administración</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("LoginEmpleado", "Empleados")">Portal Empleados</a></li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content mt-4">
        @RenderBody()
        <hr />
        <footer class="text-center pb-3">
            <p>&copy; @DateTime.Now.Year - Grupo Juárez y Asociados | Sistema de Vacaciones</p>
        </footer>
    </div>

    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
