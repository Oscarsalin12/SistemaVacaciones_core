@model List<SistemaVacaciones.Core.ViewModels.MotivosAusenciaVM>

<link href="~/Content/bootstrap.css" rel="stylesheet" />
@section Styles {
    <link href="~/css/motivos.css" rel="stylesheet" />
}

<div class="content-box">
    <div class="content-header">
        Catálogo de Motivos
    </div>

    <div class="text-end mb-3">
        <button class="btn btn-success" onclick="abrirModal(0)">Nuevo Motivo</button>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped w-100" id="tablaMotivos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descuenta Días</th>
                    <th>Descuenta Horas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id="fila-@item.Id">
                        <td class="text-start">@item.NombreMotivo</td>
                        <td>
                            @if (item.BitDescuentoDias)
                            {
                                <span class="badge bg-success" style="font-size: 0.9em;">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary" style="font-size: 0.9em;">No</span>
                            }
                        </td>
                        <td>
                            @if (item.BitDescuentoHoras)
                            {
                                <span class="badge bg-success" style="font-size: 0.9em;">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary" style="font-size: 0.9em;">No</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-gradient btn-sm" onclick="abrirModal(@item.Id)">Editar</button>
                            <button class="btn btn-danger btn-sm" onclick="eliminarMotivo(@item.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalMotivo" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header content-header m-0 mb-3" style="border-radius: 0;">
                <h5 class="modal-title text-white" id="modalTitle">Motivo</h5>
            </div>
            <div class="modal-body" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="$('#modalMotivo').modal('hide')">Cerrar</button>
                <button type="button" class="btn btn-gradient" onclick="guardar()">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
    const modalElement = $('#modalMotivo'); // Usamos jQuery solo para el trigger del modal de Bootstrap

    async function abrirModal(id) {
        const title = id === 0 ? "Nuevo Motivo" : "Editar Motivo";
        const url = id === 0 ? '@Url.Action("Create")' : `@Url.Action("Edit")/${id}`;

        document.getElementById('modalTitle').innerText = title;

        const response = await fetch(url);
        const html = await response.text();
        document.getElementById('modalBody').innerHTML = html;

        modalElement.modal('show');
    }

    async function guardar() {
        const form = document.getElementById('formMotivo');
        const formData = new FormData(form);

        // Convertir checkbox a boolean explícito para el ViewModel
        const id = formData.get("Id");
        const url = id == "0" ? '@Url.Action("Create")' : '@Url.Action("Edit")';

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            const resultado = await response.json();
            if (resultado.success) {
                location.reload(); // Recarga simple para ver cambios
            } else {
                alert(resultado.message);
            }
        } catch (error) {
            alert('Error de comunicación con el servidor');
        }
    }

    async function eliminarMotivo(id) {
        if (!confirm("¿Deseas eliminar este registro?")) return;

        try {
            const response = await fetch(`@Url.Action("Delete")/${id}`, { method: 'POST' });
            const res = await response.json();

            if (res.success) {
                document.getElementById(`fila-${id}`).remove(); // Manipulación directa del DOM
            } else {
                alert('No se pudo eliminar el registro. Es posible que esté en uso.');
            }
        } catch (error) {
            alert('Error de comunicación con el servidor');
        }
    }
    </script>
}