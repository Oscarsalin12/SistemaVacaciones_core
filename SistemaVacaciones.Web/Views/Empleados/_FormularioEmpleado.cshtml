@model SistemaVacaciones.Core.Entities.Empleado

<form id="frmEmpleado">
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.IdEmpresa)

    <div class="row">
        <div class="col-md-6 form-group mb-2">
            <label>Número de Empleado</label>
            @Html.TextBoxFor(m => m.NumEmpleado, new { @class = "form-control", type = "number", required = "required" })
        </div>
        <div class="col-md-6 form-group mb-2">
            <label>Nombre Completo</label>
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", required = "required" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 form-group mb-2">
            <label>Fecha de Ingreso</label>
            @Html.TextBoxFor(m => m.FechaIDeIngreso, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", required = "required" })
        </div>
        <div class="col-md-6 form-group mb-2">
            <label>Departamento</label>
            @Html.DropDownListFor(m => m.IdDepartamento, (SelectList)ViewBag.Departamentos, "Seleccione...", new { @class = "form-control", required = "required" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 form-group mb-2">
            <label>Días Lab. x Semana</label>
            @Html.DropDownListFor(m => m.DiasLaboralesPorSemana, new List<SelectListItem>
            {
                new SelectListItem { Text = "Lunes a Viernes (5 días)", Value = "5" },
                new SelectListItem { Text = "Lunes a Sábado (6 días)", Value = "6" }
            }, new { @class = "form-control", required = "required" })
        </div>
        <div class="col-md-4 form-group mb-2">
            <label>Usuario Sistema</label>
            @Html.TextBoxFor(m => m.UsuarioEmpleado, new { @class = "form-control" })
        </div>
        <div class="col-md-4 form-group mb-2">
            <label>Estado</label>
            @Html.DropDownListFor(m => m.Estado, new SelectList(new[] { "Activo", "Inactivo" }), new { @class = "form-control" })
        </div>
    </div>
</form>