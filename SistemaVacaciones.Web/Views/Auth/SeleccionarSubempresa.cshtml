@inject SistemaVacaciones.Core.Interfaces.IAuthServices AuthServices
@model List<SistemaVacaciones.Core.ViewModels.SubEmpresasVM>
@using SistemaVacaciones.Core.Entities
@{
    ViewBag.Title = "Selecciona una subempresa";

    // LÓGICA PARA VERIFICAR SI ES ADMIN
    bool esAdministrador = false;
    if (User.Identity?.IsAuthenticated == true)
    {
        if (User.Identity.Name == "Admin" || User.IsInRole("Admin") || User.IsInRole("Administrador") || User.IsInRole("AdministradorGeneral"))
        {
            esAdministrador = true;
        }
        else
        {
            esAdministrador = AuthServices.EsAdmin(User.Identity.Name ?? "");
        }
    }
}

<div class="container mt-4 mb-3">
    @Html.ActionLink("? Volver a Empresas", "Perfil", "Auth", null, new { @class = "btn btn-secondary", style = "border-radius: 8px;" })
</div>

<div class="container subempresa-container">
    <h2 class="subempresa-header">@ViewBag.EmpresaMadre - Subempresas</h2>

    @* AQUÍ APLICAMOS LA RESTRICCIÓN DEL BOTÓN *@
    @if (esAdministrador)
    {
        <div class="text-center mb-4">
            <button type="button" class="btn btn-gradient-auto"
                    onclick="cargarFormulario('@Url.Action("InsertarSubEmpresa", "Empresas", new { idEmpresaMadre = ViewBag.EmpresaId })', 'Nueva Subempresa')">
                ? Registrar Subempresa
            </button>
        </div>
    }

    <div class="row">
        @foreach (var sub in Model)
        {
            <div class="col-md-4 mb-4 d-flex align-items-stretch">
                <div class="card card-subempresa w-100">
                    @if (sub.Logo != null && sub.Logo.Length > 0)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(sub.Logo)"
                             class="card-img-top"
                             alt="Logo de @sub.Nombre"
                             style="max-height: 150px; object-fit: contain; padding: 10px;" />
                    }
                    else
                    {
                        <img src="~/Content/imagenes/no-logo.png"
                             class="card-img-top"
                             alt="Sin logo"
                             style="max-height: 150px; object-fit: contain; padding: 10px;" />
                    }
                    <div class="card-body text-center d-flex flex-column">
                        <h5 class="card-title">@sub.Nombre</h5>
                        <p class="card-text mb-1"><strong>Sucursal:</strong> @sub.Sucursal</p>
                        <p class="card-text mb-1"><strong>RFC:</strong> @sub.Rfc</p>
                        <p class="card-text mb-3"><strong>Dirección:</strong> @sub.Direccion</p>
                        <div class="mt-auto">
                            <a href="@Url.Action("ListaEmpleadosSubempresa", "Empleados", new { idSub = sub.Id })" class="btn btn-gradient">
                                Ver Empleados
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="modalGeneral" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo">Formulario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalCuerpo">
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/auth.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/auth.js"></script>
}