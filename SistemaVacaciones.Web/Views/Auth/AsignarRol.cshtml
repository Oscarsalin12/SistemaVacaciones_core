@model SistemaVacaciones.Core.ViewModels.AsignarRolVM

@{
    ViewBag.Title = "AsignarRol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/css/auth.css" rel="stylesheet" />
}

<div class="asignarrol-container">
    <h2 class="asignarrol-header">Asignar Rol a Usuario</h2>

    @using (Html.BeginForm("AsignarRol", "Auth", FormMethod.Post))
    {
        @Html.HiddenFor(Model => Model.IdUsuario)

        <div class="form-group">
            @Html.LabelFor(model => model.IdRol, "Rol")
            @Html.DropDownListFor(model => model.IdRol, new SelectList(Model.ListaRoles, "Value", "Text"), "Seleccione un rol", new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.IdEmpresa, "Empresa")
            @Html.DropDownListFor(model => model.IdEmpresa, new SelectList(Model.ListaEmpresas, "Value", "Text"), "Seleccione una empresa", new { @class = "form-control" })
        </div>

        <button type="submit" class="btn btn-primary">Asignar Rol</button>
    }
</div>
