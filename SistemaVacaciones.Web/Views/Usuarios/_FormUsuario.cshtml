@model SistemaVacaciones.Core.ViewModels.UsuariosVM

<form id="formUsuario">
    @Html.HiddenFor(m => m.Id)

    <div class="form-group mb-2">
        <label>Nombre de Usuario</label>
        @Html.TextBoxFor(m => m.Usuario, new { @class = "form-control", required = "required" })
    </div>

    <div class="form-group mb-2">
        <label>Contraseña</label>
        @Html.PasswordFor(m => m.Contrasenia, new { @class = "form-control", placeholder = Model.Id > 0 ? "Dejar en blanco para no cambiar" : "" })
    </div>

    <div class="form-check mt-3">
        @Html.CheckBoxFor(m => m.BitAdministrador, new { @class = "form-check-input", id = "chkAdmin" })
        <label class="form-check-label" for="chkAdmin">¿Es Administrador?</label>
    </div>
</form>