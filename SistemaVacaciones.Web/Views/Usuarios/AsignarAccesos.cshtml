@model SistemaVacaciones.Core.ViewModels.AsignarPermisosVM

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<style>
    /* Estilos del contenedor principal */
    .content-box {
        background-color: white;
        padding: 30px;
        margin: 40px auto;
        border-radius: 15px;
        max-width: 1000px; /* Un poco más angosto para formularios se ve mejor */
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
    }

    /* Estilo del encabezado con el degradado */
    .content-header {
        background: linear-gradient(to right, #0000ff, #4b0082);
        color: white;
        padding: 15px;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 22px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 25px;
        margin-top: -30px; /* Para pegarlo al borde superior del padding */
        margin-left: -30px;
        margin-right: -30px;
    }

    /* Estilos de inputs y botones */
    .form-control {
        border-radius: 8px;
    }

    .btn-gradient {
        background: linear-gradient(to right, #0000ff, #4b0082);
        border: none;
        color: white;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 500;
        transition: background 0.3s ease;
    }

        .btn-gradient:hover {
            background: linear-gradient(to right, #5a379e, #0000ff);
            color: white;
        }

    /* Mejorar la apariencia de los checkboxes */
    .subempresa-item {
        margin-bottom: 15px;
    }

    .custom-control-label {
        cursor: pointer;
        font-weight: 500;
    }
</style>

<div class="content-box">
    <div class="content-header">
        Asignar Permisos y Accesos
    </div>

    @using (Html.BeginForm("AsignarAccesos", "Usuarios", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.IdUsuario)

        <div class="row">
            <div class="col-md-6 mb-4">
                <label class="font-weight-bold text-dark">1. Selecciona el Rol:</label>
                @Html.DropDownListFor(m => m.IdRol, new SelectList(Model.ListaRoles, "Id", "Nombre"), "-- Seleccionar Rol --", new { @class = "form-control", id = "ddlRol" })
            </div>

            <div class="col-md-6 mb-4">
                <label class="font-weight-bold text-dark">2. Empresa Principal (Madre):</label>
                @Html.DropDownListFor(m => m.IdEmpresa, new SelectList(Model.ListaEmpresas, "Id", "Nombre"), "-- Seleccionar Empresa --", new { @class = "form-control", id = "ddlEmpresaMadre" })
            </div>
        </div>

        <hr class="my-4" />

        <div id="seccionSubEmpresas" class="p-3 bg-light" style="border-radius: 10px; border: 1px solid #dee2e6;">
            <label class="font-weight-bold text-dark mb-3">3. Selecciona Sucursales (SubEmpresas):</label>
            <div class="row mt-2">
                @foreach (var sub in Model.ListaSubEmpresas)
                {
                    // VERIFICAMOS SI ESTA SUBEMPRESA YA ESTÁ EN LOS ACCESOS DEL USUARIO
                    bool isChecked = Model.idSubEmpresas != null && Model.idSubEmpresas.Contains(sub.Id);

                    <div class="col-md-4 subempresa-item" data-madre="@sub.IdEmpresa_madre">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" name="idSubEmpresas" value="@sub.Id" class="custom-control-input chk-sub" id="sub_@sub.Id" @(isChecked ? "checked" : "")>
                            <label class="custom-control-label" for="sub_@sub.Id">
                                @sub.Nombre - <span class="badge badge-secondary">@sub.Sucursal</span>
                            </label>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="mt-4 text-right">
            <a href="@Url.Action("Index", "Usuarios")" class="btn btn-secondary btn-lg mr-2">
                <i class="fas fa-arrow-left mr-2"></i> Volver al listado
            </a>

            <button type="submit" class="btn btn-gradient btn-lg">
                <i class="fas fa-save mr-2"></i> Guardar Permisos
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Disparar el cambio manualmente al cargar la página para que filtre
            // las sucursales según la empresa precargada (si la hay)
            if ($('#ddlEmpresaMadre').val()) {
                $('#ddlEmpresaMadre').trigger('change');
            }

            // Filtrar subempresas al cambiar la Empresa Madre
            $('#ddlEmpresaMadre').change(function () {
                var idMadre = $(this).val();
                if (idMadre) {
                    $('.subempresa-item').hide();
                    $('.subempresa-item[data-madre="' + idMadre + '"]').show();
                } else {
                    $('.subempresa-item').show();
                }
            });

            // Lógica de Admin (Auto-seleccionar todo)
            $('#ddlRol').change(function () {
                var texto = $(this).find("option:selected").text().toLowerCase();
                if (texto.includes("admin")) {
                    $('.chk-sub').prop('checked', true);
                    toastr.info("Modo Administrador: Se han marcado todas las sucursales.");
                }
            });
        });
    </script>
}