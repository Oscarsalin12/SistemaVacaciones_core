@model SistemaVacaciones.Core.Entities.Empresa

<form id="formGenerico" action="@Url.Action("InsertarEmpresa", "Empresas")" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-12 mb-3">
            <label class="form-label fw-bold">Nombre de la Empresa</label>
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Ej. Empresa S.A." })
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">RFC</label>
            @Html.TextBoxFor(m => m.Rfc, new { @class = "form-control", placeholder = "ABC123456XYZ" })
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Dirección</label>
            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
        </div>

        <div class="col-md-12 mb-3">
            <label class="form-label fw-bold">Logo Corporativo</label>
            <input type="file" name="archivoLogo" class="form-control" accept="image/*" />
            <small class="text-muted">Se recomienda formato PNG o JPG.</small>
        </div>
    </div>

    <div class="modal-footer px-0 pb-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
        <button type="submit" class="btn btn-primary">Guardar Empresa</button>
    </div>
</form>
